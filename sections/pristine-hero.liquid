{%- comment -%}
  Oak: Pristine landing page hero. Image left, nude text panel right; stacks with the image on top on mobile.
  Holds the page's only H1, and the image loads eagerly because it is above the fold.
{%- endcomment -%}

{%- assign image = section.settings.image -%}

<div class="pristine-section pristine-hero">
  <div class="page-width">
    <div class="pristine-hero__inner">
      <div class="pristine-hero__media">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 1800
            | image_tag:
              widths: '375, 550, 750, 900, 1100, 1300, 1500, 1800',
              sizes: '(min-width: 769px) 50vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              class: 'pristine-hero__image'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'pristine-hero__image pristine-placeholder' }}
        {%- endif -%}
      </div>

      <div class="pristine-hero__panel">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pristine-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="pristine-heading pristine-hero__title">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="pristine-text pristine-hero__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
          <div class="pristine-buttons">
            {%- if section.settings.button_1_label != blank -%}
              <a class="pristine-btn pristine-btn--primary" href="{{ section.settings.button_1_link | default: '#' }}">
                {{- section.settings.button_1_label | escape -}}
              </a>
            {%- endif -%}
            {%- if section.settings.button_2_label != blank -%}
              <a class="pristine-btn pristine-btn--secondary" href="{{ section.settings.button_2_link | default: '#' }}">
                {{- section.settings.button_2_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.note != blank -%}
          <p class="pristine-hero__note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pristine hero",
  "class": "pristine-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shown on the left on desktop and on top on mobile. Loads immediately, so keep it to one well-compressed photo."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (H1)",
      "info": "The page's only H1."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label (black)"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link",
      "info": "Link to #start to jump to the \"Two ways to start\" section."
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label (outlined)"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small text under the buttons",
      "info": "For example a rating line. Hidden when blank."
    }
  ],
  "presets": [
    {
      "name": "Pristine hero"
    }
  ]
}
{% endschema %}
