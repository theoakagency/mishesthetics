{%- comment -%}
  Oak: "Two ways to start". Product cards (image, title and live price from the picked product) followed by a
  comparison table built from row blocks. The wrapper carries id="start" so buttons elsewhere can link to #start.
{%- endcomment -%}

{%- liquid
  assign card_blocks = section.blocks | where: 'type', 'product_card'
  assign row_blocks = section.blocks | where: 'type', 'row'
-%}

<div class="pristine-section pristine-compare" id="{{ section.settings.anchor_id | default: 'start' | handle }}">
  <div class="page-width">
    {%- render 'pristine.section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text
    -%}

    {%- if card_blocks.size > 0 -%}
      <ul class="pristine-compare__cards" role="list">
        {%- for block in card_blocks -%}
          {%- assign card_product = block.settings.product -%}
          <li class="pristine-card pristine-card--white pristine-product-card" {{ block.shopify_attributes }}>
            <div class="pristine-product-card__media">
              {%- if card_product.featured_image != blank -%}
                {{
                  card_product.featured_image
                  | image_url: width: 900
                  | image_tag:
                    widths: '300, 450, 600, 750, 900',
                    sizes: '(min-width: 769px) 40vw, 100vw',
                    loading: 'lazy',
                    class: 'pristine-product-card__image'
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'pristine-product-card__image pristine-placeholder' }}
              {%- endif -%}
            </div>

            <div class="pristine-product-card__body">
              {%- if block.settings.eyebrow != blank -%}
                <p class="pristine-eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}
              {%- if card_product != blank -%}
                <h3 class="pristine-product-card__title">{{ card_product.title | escape }}</h3>
              {%- endif -%}

              <p class="pristine-product-card__price">
                {%- if block.settings.price_override != blank -%}
                  {{ block.settings.price_override | escape }}
                {%- elsif card_product != blank -%}
                  {%- if card_product.price_varies -%}
                    {% render 'utility.translate', key: 'labels.from', fallback: 'From' %}
                    {{ card_product.price_min | money }}
                  {%- else -%}
                    {{ card_product.price | money }}
                  {%- endif -%}
                {%- endif -%}
              </p>

              {%- if block.settings.text != blank -%}
                <p class="pristine-card__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}

              {%- if card_product != blank and block.settings.button_label != blank -%}
                <a class="pristine-btn pristine-btn--primary pristine-product-card__button" href="{{ card_product.url }}">
                  {{- block.settings.button_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if row_blocks.size > 0 -%}
      <div
        class="pristine-table-scroll"
        role="region"
        tabindex="0"
        {% if section.settings.table_caption != blank %}
          aria-label="{{ section.settings.table_caption | escape }}"
        {% endif %}
      >
        <table class="pristine-table">
          {%- if section.settings.table_caption != blank -%}
            <caption class="visually-hidden">{{ section.settings.table_caption | escape }}</caption>
          {%- endif -%}
          <thead>
            <tr>
              {%- if section.settings.label_heading != blank -%}
                <th scope="col">{{ section.settings.label_heading | escape }}</th>
              {%- else -%}
                <td></td>
              {%- endif -%}
              <th scope="col">{{ section.settings.column_1_heading | escape }}</th>
              <th scope="col">{{ section.settings.column_2_heading | escape }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in row_blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.label | escape }}</th>
                <td>{{ block.settings.column_1 | escape }}</td>
                <td>{{ block.settings.column_2 | escape }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Pristine compare",
  "limit": 1,
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "start",
      "info": "Buttons linking to #start jump here."
    },
    {
      "type": "header",
      "content": "Comparison table"
    },
    {
      "type": "text",
      "id": "table_caption",
      "label": "Table description for screen readers"
    },
    {
      "type": "text",
      "id": "label_heading",
      "label": "First column heading",
      "info": "Optional. Leave blank for an empty corner cell."
    },
    {
      "type": "text",
      "id": "column_1_heading",
      "label": "Column 1 heading"
    },
    {
      "type": "text",
      "id": "column_2_heading",
      "label": "Column 2 heading"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "limit": 2,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Image, title and price come from the product."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "price_override",
          "label": "Price text override",
          "info": "Replaces the live price when filled in."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        }
      ]
    },
    {
      "type": "row",
      "name": "Table row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label"
        },
        {
          "type": "text",
          "id": "column_1",
          "label": "Column 1"
        },
        {
          "type": "text",
          "id": "column_2",
          "label": "Column 2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pristine compare",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
