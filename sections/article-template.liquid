{%- render 'section.article-template' -%}

{%- comment -%}
  Oak: added show_more_from and show_back_link settings (both default on), and show_share and
  show_author_box (both default off)
{%- endcomment -%}

{% schema %}
{
  "name": "t:labels.article_pages",
  "class": "blog-layout__main",
  "settings": [
    {
      "type": "checkbox",
      "id": "blog_show_image",
      "label": "t:actions.show_article_image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_capitalize_first",
      "label": "t:actions.capitalize_first_letter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_show_tags",
      "label": "t:actions.show_tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_show_date",
      "label": "t:actions.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_show_comments",
      "label": "t:actions.show_comment_count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "blog_show_author",
      "label": "t:actions.show_author"
    },
    {
      "type": "checkbox",
      "id": "show_more_from",
      "label": "Show \"More from\" tag links below the article",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_back_link",
      "label": "Show \"Back to blog\" button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show \"Share this\" links below the article",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_author_box",
      "label": "Show author box below the article",
      "info": "Uses the Blog author entry (Content > Metaobjects) whose Name matches the post's author.",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
