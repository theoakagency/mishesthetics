{% doc %}
  Copyright © 2025 Archetype Themes LP. All rights reserved.

  Multi-column text layout with optional images for features or benefits.

  @param {string} [title] - Section heading
  @param {string} [align_text] - ('left'|'center'|'right') Text alignment
  @param {boolean} [divider] - Show divider above section
  @param {string} [heading_size] - ('sm'|'md'|'lg'|'xl') Heading size
  @param {string} [color_scheme] - ('none'|'1'|'2'|'3') Color scheme
  @param {number} [columns_desktop] - Columns per row on desktop, 0 = automatic from block count (tablet is capped at 3)
  @param {number} [columns_mobile] - Columns per row on mobile (1-3)
  @param {number} [column_heading_size] - Column heading size in px, 0 = theme default
  @param {number} [column_text_size] - Column text size in px, 0 = theme default

  @example
  {% render 'section.text-columns', align_text: 'center', heading_size: 'lg' %}
{% enddoc %}

{%- liquid
  assign align_text = align_text | default: section.settings.align_text | default: 'center'
  assign title = title | default: section.settings.title
  assign divider = divider | default: section.settings.divider, allow_false: true | default: false, allow_false: true
  assign heading_size = heading_size | default: section.settings.heading_size | default: 'md'
  assign color_scheme = color_scheme | default: section.settings.color_scheme | default: 'none'
  assign columns_desktop = columns_desktop | default: section.settings.columns_desktop | default: 0 | times: 1
  assign columns_mobile = columns_mobile | default: section.settings.columns_mobile | default: 1 | times: 1
  assign column_heading_size = column_heading_size | default: section.settings.column_heading_size | default: 0 | times: 1
  assign column_text_size = column_text_size | default: section.settings.column_text_size | default: 0 | times: 1

  assign columns_tablet = columns_desktop
  if columns_tablet > 3
    assign columns_tablet = 3
  endif

  unless color_scheme
    assign class_name = 'text-columns-' | append: section.id
    render 'utility.color-scheme-override', class_name: class_name
  endunless
-%}

{%- comment -%}
  Layout and text overrides, scoped to this section instance.
  Nothing is emitted at the defaults (0 / 0 / 0 / mobile 1) so existing sections are unchanged.
{%- endcomment -%}
{%- if columns_desktop > 0 or columns_mobile > 1 or column_heading_size > 0 or column_text_size > 0 -%}
  {% style %}
    {%- if columns_desktop > 0 -%}
      #shopify-section-{{ section.id }} .text-columns__grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
      }

      #shopify-section-{{ section.id }} .text-columns__grid::before,
      #shopify-section-{{ section.id }} .text-columns__grid::after {
        display: none;
      }

      #shopify-section-{{ section.id }} .text-columns__grid > .grid__item {
        float: none;
        flex: 0 0 {{ 100.0 | divided_by: columns_mobile | round: 4 }}%;
        max-width: {{ 100.0 | divided_by: columns_mobile | round: 4 }}%;
      }

      /* Same-size icon boxes so icons and headings line up across the row */
      #shopify-section-{{ section.id }} .text-columns__grid .image-wrap {
        padding-bottom: 100% !important;
      }

      #shopify-section-{{ section.id }} .text-columns__grid .image-wrap img {
        object-fit: contain;
      }

      @media only screen and (min-width: 769px) {
        #shopify-section-{{ section.id }} .text-columns__grid > .grid__item {
          flex-basis: {{ 100.0 | divided_by: columns_tablet | round: 4 }}%;
          max-width: {{ 100.0 | divided_by: columns_tablet | round: 4 }}%;
        }
      }

      @media only screen and (min-width: 960px) {
        #shopify-section-{{ section.id }} .text-columns__grid > .grid__item {
          flex-basis: {{ 100.0 | divided_by: columns_desktop | round: 4 }}%;
          max-width: {{ 100.0 | divided_by: columns_desktop | round: 4 }}%;
        }
      }
    {%- elsif columns_mobile > 1 -%}
      @media only screen and (max-width: 768px) {
        #shopify-section-{{ section.id }} .text-columns__grid > .grid__item {
          width: {{ 100.0 | divided_by: columns_mobile | round: 4 }}%;
        }

        #shopify-section-{{ section.id }} .text-columns__grid > .grid__item:nth-of-type({{ columns_mobile }}n + 1) {
          clear: left;
        }
      }
    {%- endif -%}

    {%- if column_heading_size > 0 -%}
      #shopify-section-{{ section.id }} .text-columns__grid .grid__item > h2 {
        font-size: {{ column_heading_size }}px;
        line-height: 1.3;
      }
    {%- endif -%}

    {%- if column_text_size > 0 -%}
      #shopify-section-{{ section.id }} .text-columns__grid .rte-setting,
      #shopify-section-{{ section.id }} .text-columns__grid .rte-setting :is(p, ul, ol, li) {
        font-size: {{ column_text_size }}px;
      }
    {%- endif -%}
  {% endstyle %}
{%- endif -%}

{%- if divider -%}<div class="section--divider">{%- endif -%}

<div class="index-section color-scheme-{{ color_scheme }} text-columns-{{ section.id }}">
  {%- render 'utility.color-scheme-texture', color_scheme: color_scheme -%}

  <div class="page-width" style="z-index: 1;">
    {%- if title != blank -%}
      <div class="section-header text-{{ align_text }}">
        <h2 class="heading-{{ heading_size }}">{{ title }}</h2>
      </div>
    {%- endif -%}

    <div class="text-columns__grid float-grid{% unless section.blocks.size == 5 %} grid--uniform{% endunless %} grid--flush-bottom clearfix">
      {%- liquid
        assign grid_item_width = 'medium-up--one-third'
        case section.blocks.size
          when 1
            assign grid_item_width = 'medium-up--one-half'
          when 2
            assign grid_item_width = 'medium-up--one-half'
          when 4
            assign grid_item_width = 'medium-up--one-half'
        endcase
      -%}
      {%- for block in section.blocks -%}
        {%- if section.blocks.size == 5 and forloop.index < 3 -%}
          {%- assign column_width = 'medium-up--one-half' -%}
        {%- else -%}
          {%- assign column_width = grid_item_width -%}
        {%- endif -%}
        <div class="grid__item {{ column_width }} text-{{ align_text }}" {{ block.shopify_attributes }}>
          {%- if block.settings.enable_image -%}
            <div style="{% if align_text == 'center' %}margin: 0 auto;{% elsif align_text == 'right' %}margin-inline-start: auto;{% endif %} max-width: {{ block.settings.image_width }}px;">
              {%- if block.settings.button_link != blank -%}
                <a href="{{ block.settings.button_link }}">
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                <div
                  class="image-wrap text-spacing {% if block.settings.image_mask != 'none' %}svg-mask svg-mask--{{ block.settings.image_mask }}{% endif %}"
                  style="height: 0; padding-bottom: {{ 100 | divided_by: block.settings.image.aspect_ratio }}%;"
                >
                  {%- render 'element.image',
                    img: block.settings.image,
                    sizeVariable: column_width,
                    widths: '180, 360, 540, 720, 900, 1080',
                    style: 'height: 100%;'
                  -%}
                </div>
              {%- elsif block.settings.map_address != blank -%}
                <div class="image-wrap text-spacing">
                  {%- render 'element.map',
                    map_address: block.settings.map_address,
                    access_token: block.settings.api_key,
                    aspect_ratio: block.settings.image_mask,
                    style_url: block.settings.style_url
                  -%}
                </div>
              {%- else -%}
                <div class="image-wrap text-spacing">
                  {%- render 'element.placeholder', name: 'image', no_padding: true -%}
                </div>
              {%- endif -%}
              {%- if block.settings.button_link != blank -%}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h2 class="heading-{{ heading_size }} rte--block">
              {{ block.settings.title }}
            </h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="rte-setting rte--block text-spacing">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            {%- render 'element.button',
              href: block.settings.button_link,
              text: block.settings.button_label,
              inverted: true
            -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- if divider -%}</div>{%- endif -%}
