{% doc %}
  Copyright © 2025 Archetype Themes LP. All rights reserved.

  Blog sidebar with recent posts, tags, and navigation.

  @param {object} [blog] - Blog object
  @param {object} [article] - Current article

  @example
  {% render 'section.blog-sidebar', blog: blog %}
{% enddoc %}

{% stylesheet %}
  /* Oak: "Recent posts" sidebar block */
  .recent-articles {
    display: grid;
    gap: 16px;
    margin: 0;
  }

  .recent-articles__link {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: inherit;

    &:hover .recent-articles__title,
    &:focus-visible .recent-articles__title {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }

  .recent-articles__image {
    flex: 0 0 80px;
    width: 80px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--roundness, 4px);

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .recent-articles__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .recent-articles__title {
    font-size: var(--element-text-font-size--body-md);
    line-height: 1.35;
  }

  .recent-articles__date {
    font-size: calc(var(--element-text-font-size--body-md) * 0.85);
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Oak: "Featured collection" sidebar block. A swipe row showing 2.5 cards at every screen size. */
  .sidebar-products__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-block-end: var(--size-5);

    & h4 {
      margin: 0;
    }
  }

  .sidebar-products__arrows {
    display: flex;
    gap: 4px;
    margin-inline-start: auto;
  }

  .sidebar-products__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-primary) var(--shade-12), var(--color-secondary));
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;

    & svg {
      width: 14px;
      height: 14px;
    }

    &:disabled {
      opacity: 0.35;
      cursor: default;
    }
  }

  .sidebar-products {
    --sidebar-products-gap: 12px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--sidebar-products-gap) * 2) / 2.5);
    gap: var(--sidebar-products-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* The gridlines product style draws each card's border just outside the card. A scroll
       container clips anything outside it, so leave room or the top/bottom lines disappear. */
    padding: 2px;
    scroll-padding-inline: 2px;

    &::-webkit-scrollbar {
      display: none;
    }

    & > .grid-item {
      scroll-snap-align: start;
      flex: none;
      width: auto;
      margin: 0;
      padding: 0;
    }
  }

  /* Oak: "List" style for the tags (Explore more) block: one bold text link per row */
  .tag-list {
    margin: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-primary) var(--shade-12), var(--color-secondary));
  }

  .tag-list__item {
    border-bottom: 1px solid color-mix(in srgb, var(--color-primary) var(--shade-12), var(--color-secondary));
  }

  .tag-list__link {
    display: block;
    padding: 14px 0;
    font-weight: 700;
    text-decoration: none;
    color: inherit;

    &:hover,
    &:focus-visible {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
{% endstylesheet %}

{%- liquid
  assign blog = section.settings.blog | default: blog
  assign article = section.settings.article | default: article
-%}

{%- comment -%}
  Oak: sticky sidebar offset for the two-column article template (.blog-layout--split, desktop).
  Sticks 24px below the sticky header when it fits on screen; when it's taller than the screen,
  the offset goes negative so the sidebar scrolls until its bottom is visible, then sticks.
{%- endcomment -%}
<script>
  (() => {
    const sidebar = document.currentScript.closest('.blog-layout--split > .blog-layout__sidebar');
    if (!sidebar) return;
    const gap = 24;
    const update = () => {
      if (window.innerWidth < 769) {
        sidebar.style.removeProperty('--oak-sidebar-top');
        return;
      }
      const header = document.querySelector('.site-header');
      const headerBottom = header && header.dataset.sticky === 'true' ? Math.max(0, header.getBoundingClientRect().bottom) : 0;
      const top = Math.min(headerBottom + gap, window.innerHeight - sidebar.offsetHeight - gap);
      sidebar.style.setProperty('--oak-sidebar-top', Math.round(top) + 'px');
    };
    update();
    window.addEventListener('resize', update);
    document.addEventListener('headerStickyChange', update);
    window.addEventListener('load', update);
    if ('ResizeObserver' in window) new ResizeObserver(update).observe(sidebar);
  })();
</script>

{%- if section.blocks.size == 0 -%}
  <style>
    .blog-layout__sidebar {
      display: none;
    }
  </style>
{%- endif -%}

{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when 'recent_articles' -%}
      {%- comment -%}
        Oak: posts from this blog, skipping the article being read. With "Prefer posts with the same
        tag" on, posts sharing a tag with this one come first (newest first), then the newest posts
        fill any remaining spots. Picks are collected as handles in two groups (tag matches, fill),
        then rendered in two passes over the blog so tag matches always come first.
      {%- endcomment -%}
      {%- liquid
        assign recent_count = block.settings.count | default: 6
        assign picked = '|'
        assign picked_related = '|'
        assign picked_count = 0

        if block.settings.match_tags and article.tags.size > 0
          for candidate in blog.articles limit: 50
            if picked_count >= recent_count
              break
            endif
            if candidate.id == article.id
              continue
            endif
            assign shares_tag = false
            for tag in candidate.tags
              if article.tags contains tag
                assign shares_tag = true
                break
              endif
            endfor
            if shares_tag
              assign picked = picked | append: candidate.handle | append: '|'
              assign picked_related = picked_related | append: candidate.handle | append: '|'
              assign picked_count = picked_count | plus: 1
            endif
          endfor
        endif

        for candidate in blog.articles limit: 50
          if picked_count >= recent_count
            break
          endif
          assign candidate_key = '|' | append: candidate.handle | append: '|'
          if candidate.id == article.id or picked contains candidate_key
            continue
          endif
          assign picked = picked | append: candidate.handle | append: '|'
          assign picked_count = picked_count | plus: 1
        endfor
      -%}
      {%- if picked_count > 0 -%}
        <div class="theme-block" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h4>{{ block.settings.title }}</h4>
          {%- endif -%}
          <ul class="recent-articles no-bullets">
            {%- for pass in (1..2) -%}
            {%- for recent in blog.articles limit: 50 -%}
              {%- liquid
                assign recent_key = '|' | append: recent.handle | append: '|'
                assign is_picked = false
                if picked contains recent_key
                  if pass == 1 and picked_related contains recent_key
                    assign is_picked = true
                  elsif pass == 2
                    unless picked_related contains recent_key
                      assign is_picked = true
                    endunless
                  endif
                endif
              -%}
              {%- unless is_picked -%}
                {%- continue -%}
              {%- endunless -%}
              <li class="recent-articles__item">
                <a href="{{ recent.url }}" class="recent-articles__link">
                  {%- if block.settings.show_image and recent.image -%}
                    <span class="recent-articles__image">
                      {%- render 'element.image',
                        img: recent.image,
                        sizes: '80px',
                        widths: '80, 160, 240',
                        alt: recent.title
                      -%}
                    </span>
                  {%- endif -%}
                  <span class="recent-articles__text">
                    <span class="recent-articles__title">{{ recent.title }}</span>
                    {%- if block.settings.show_date -%}
                      <span class="recent-articles__date">
                        {{- recent.published_at | date: format: 'abbreviated_date' -}}
                      </span>
                    {%- endif -%}
                  </span>
                </a>
              </li>
            {%- endfor -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- when 'featured_collection' -%}
      {%- comment -%}
        Oak: product cards from a chosen collection, as a swipeable row showing 2.5 cards at every
        screen size so it's clear there's more. Prev/next arrows let mouse users scroll it too.
      {%- endcomment -%}
      {%- assign sidebar_collection = block.settings.collection -%}
      {%- if sidebar_collection != blank and sidebar_collection.products_count > 0 -%}
        <div class="theme-block" {{ block.shopify_attributes }}>
          <div class="sidebar-products__header">
            {%- if block.settings.title != blank -%}
              <h4>{{ block.settings.title }}</h4>
            {%- endif -%}
            <div class="sidebar-products__arrows">
              <button type="button" class="sidebar-products__arrow" data-sidebar-products-prev aria-label="Previous products" disabled>
                {%- render 'element.icon', name: 'chevron-left' -%}
              </button>
              <button type="button" class="sidebar-products__arrow" data-sidebar-products-next aria-label="Next products">
                {%- render 'element.icon', name: 'chevron-right' -%}
              </button>
            </div>
          </div>
          <div class="sidebar-products" data-sidebar-products>
            {%- for product in sidebar_collection.products limit: block.settings.count -%}
              {%- render 'list.product-card',
                product: product,
                sizes: '(min-width: 769px) calc((40vw - 120px) / 2.5), 40vw',
                no_actions: true,
                disabled_high_variants: false
              -%}
            {%- endfor -%}
          </div>
          <script>
            (() => {
              const block = document.currentScript.parentElement;
              const row = block.querySelector('[data-sidebar-products]');
              const prev = block.querySelector('[data-sidebar-products-prev]');
              const next = block.querySelector('[data-sidebar-products-next]');
              if (!row || !prev || !next) return;
              const step = () => {
                const card = row.firstElementChild;
                return card ? card.getBoundingClientRect().width + parseFloat(getComputedStyle(row).columnGap || 0) : row.clientWidth;
              };
              const sync = () => {
                prev.disabled = row.scrollLeft <= 2;
                next.disabled = row.scrollLeft + row.clientWidth >= row.scrollWidth - 2;
              };
              prev.addEventListener('click', () => row.scrollBy({ left: -step(), behavior: 'smooth' }));
              next.addEventListener('click', () => row.scrollBy({ left: step(), behavior: 'smooth' }));
              row.addEventListener('scroll', sync, { passive: true });
              window.addEventListener('resize', sync);
              sync();
            })();
          </script>
        </div>
      {%- endif -%}
    {%- when 'article' -%}
      <div class="theme-block" {{ block.shopify_attributes }}>
        {%- if block.settings.title != blank -%}
          <h4>{{ block.settings.title }}</h4>
        {%- endif -%}

        {%- render 'list.article-card',
          article: block.settings.article,
          show_tags: block.settings.blog_show_tags,
          show_date: block.settings.blog_show_date,
          show_comments: block.settings.blog_show_comments,
          show_author: block.settings.blog_show_author,
          show_excerpt: block.settings.blog_show_excerpt,
          image_size: block.settings.blog_image_size,
          style: 'compact'
        -%}
      </div>
    {%- when 'tags' -%}
      {%- if blog.all_tags.size > 0 -%}
        <div class="theme-block" {{ block.shopify_attributes }}>
          <h4>
            {% render 'utility.translate', key: 'actions.explore_more', fallback: 'Explore more' %}
          </h4>

          {%- if block.settings.style == 'list' -%}
            {%- comment -%} Oak: "List" style, one bold text link per row {%- endcomment -%}
            <ul class="tag-list no-bullets">
              {%- for tag in blog.all_tags -%}
                <li class="tag-list__item">
                  <a href="{{ blog.url }}/tagged/{{ tag.handle }}" class="tag-list__link">{{ tag }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            {%- capture tag_group -%}
              {%- for tag in blog.all_tags -%}
                <li>
                  {%- assign tag_link = blog.url | append: '/tagged/' | append: tag.handle -%}
                  {%- render 'element.chip', label: tag, href: tag_link -%}
                </li>
              {%- endfor -%}
            {%- endcapture -%}

            {% render 'layout.stack',
              as: 'ul',
              classlist: 'tag-group no-bullets',
              slot: tag_group,
              horizontal: true,
              gap: 'sm'
            %}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- when 'product' -%}
      {%- unless block.settings.featured_product.empty? -%}
        <div class="theme-block" {{ block.shopify_attributes }}>
          <h4>
            {% render 'utility.translate', key: 'labels.featured_product', fallback: 'Featured product' %}
          </h4>

          {%- render 'list.product-card',
            product: block.settings.featured_product,
            sizeVariable: '40vw',
            no_actions: true,
            disabled_high_variants: false
          -%}
        </div>
      {%- endunless -%}
    {%- when 'share' -%}
      {%- if article -%}
        <div class="theme-block" {{ block.shopify_attributes }}>
          <h4>
            {% render 'utility.translate', key: 'actions.share_this', fallback: 'Share this' %}
          </h4>

          {%- render 'social.sharing',
            share_title: article.title,
            share_permalink: article.url,
            share_image: article.image
          -%}
        </div>
      {%- endif -%}
  {%- endcase -%}
{%- endfor -%}
