{% doc %}
  Copyright © 2025 Archetype Themes LP. All rights reserved.

  Blog sidebar with recent posts, tags, and navigation.

  @param {object} [blog] - Blog object
  @param {object} [article] - Current article

  @example
  {% render 'section.blog-sidebar', blog: blog %}
{% enddoc %}

{% stylesheet %}
  /* Oak: "Recent posts" sidebar block */
  .recent-articles {
    display: grid;
    gap: 16px;
    margin: 0;
  }

  .recent-articles__link {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: inherit;

    &:hover .recent-articles__title,
    &:focus-visible .recent-articles__title {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }

  .recent-articles__image {
    flex: 0 0 80px;
    width: 80px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--roundness, 4px);

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .recent-articles__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .recent-articles__title {
    font-size: var(--element-text-font-size--body-md);
    line-height: 1.35;
  }

  .recent-articles__date {
    font-size: calc(var(--element-text-font-size--body-md) * 0.85);
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Oak: "Featured collection" sidebar block. Mobile: swipe row showing 2.5 cards. */
  .sidebar-products {
    --sidebar-products-gap: 12px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--sidebar-products-gap) * 2) / 2.5);
    gap: var(--sidebar-products-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    & > .grid-item {
      scroll-snap-align: start;
      flex: none;
      width: auto;
      margin: 0;
      padding: 0;
    }
  }

  /* Desktop: 3 per row, wrapping onto more rows */
  @media only screen and (min-width: 769px) {
    .sidebar-products {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      overflow: visible;
      scroll-snap-type: none;
    }
  }
{% endstylesheet %}

{%- liquid
  assign blog = section.settings.blog | default: blog
  assign article = section.settings.article | default: article
-%}

{%- comment -%}
  Oak: sticky sidebar offset for the two-column article template (.blog-layout--split, desktop).
  Sticks 24px below the sticky header when it fits on screen; when it's taller than the screen,
  the offset goes negative so the sidebar scrolls until its bottom is visible, then sticks.
{%- endcomment -%}
<script>
  (() => {
    const sidebar = document.currentScript.closest('.blog-layout--split > .blog-layout__sidebar');
    if (!sidebar) return;
    const gap = 24;
    const update = () => {
      if (window.innerWidth < 769) {
        sidebar.style.removeProperty('--oak-sidebar-top');
        return;
      }
      const header = document.querySelector('.site-header');
      const headerBottom = header && header.dataset.sticky === 'true' ? Math.max(0, header.getBoundingClientRect().bottom) : 0;
      const top = Math.min(headerBottom + gap, window.innerHeight - sidebar.offsetHeight - gap);
      sidebar.style.setProperty('--oak-sidebar-top', Math.round(top) + 'px');
    };
    update();
    window.addEventListener('resize', update);
    document.addEventListener('headerStickyChange', update);
    window.addEventListener('load', update);
    if ('ResizeObserver' in window) new ResizeObserver(update).observe(sidebar);
  })();
</script>

{%- if section.blocks.size == 0 -%}
  <style>
    .blog-layout__sidebar {
      display: none;
    }
  </style>
{%- endif -%}

{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when 'recent_articles' -%}
      {%- comment -%}
        Oak: newest posts from this blog, skipping the article being read.
      {%- endcomment -%}
      {%- liquid
        assign recent_count = block.settings.count | default: 6
        assign recent_scan = recent_count | plus: 1
        assign recent_shown = 0
      -%}
      {%- if blog.articles_count > 1 -%}
        <div class="theme-block" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h4>{{ block.settings.title }}</h4>
          {%- endif -%}
          <ul class="recent-articles no-bullets">
            {%- for recent in blog.articles limit: recent_scan -%}
              {%- if recent.id == article.id or recent_shown >= recent_count -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign recent_shown = recent_shown | plus: 1 -%}
              <li class="recent-articles__item">
                <a href="{{ recent.url }}" class="recent-articles__link">
                  {%- if block.settings.show_image and recent.image -%}
                    <span class="recent-articles__image">
                      {%- render 'element.image',
                        img: recent.image,
                        sizes: '80px',
                        widths: '80, 160, 240',
                        alt: recent.title
                      -%}
                    </span>
                  {%- endif -%}
                  <span class="recent-articles__text">
                    <span class="recent-articles__title">{{ recent.title }}</span>
                    {%- if block.settings.show_date -%}
                      <span class="recent-articles__date">
                        {{- recent.published_at | date: format: 'abbreviated_date' -}}
                      </span>
                    {%- endif -%}
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- when 'featured_collection' -%}
      {%- comment -%}
        Oak: product cards from a chosen collection. 3 per row on desktop, a swipeable row
        showing 2.5 cards on mobile so it's clear there's more to scroll.
      {%- endcomment -%}
      {%- assign sidebar_collection = block.settings.collection -%}
      {%- if sidebar_collection != blank and sidebar_collection.products_count > 0 -%}
        <div class="theme-block" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h4>{{ block.settings.title }}</h4>
          {%- endif -%}
          <div class="sidebar-products">
            {%- for product in sidebar_collection.products limit: block.settings.count -%}
              {%- render 'list.product-card',
                product: product,
                sizes: '(min-width: 769px) calc((40vw - 110px) / 3), 40vw',
                no_actions: true,
                disabled_high_variants: false
              -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- when 'article' -%}
      <div class="theme-block" {{ block.shopify_attributes }}>
        {%- if block.settings.title != blank -%}
          <h4>{{ block.settings.title }}</h4>
        {%- endif -%}

        {%- render 'list.article-card',
          article: block.settings.article,
          show_tags: block.settings.blog_show_tags,
          show_date: block.settings.blog_show_date,
          show_comments: block.settings.blog_show_comments,
          show_author: block.settings.blog_show_author,
          show_excerpt: block.settings.blog_show_excerpt,
          image_size: block.settings.blog_image_size,
          style: 'compact'
        -%}
      </div>
    {%- when 'tags' -%}
      {%- if blog.all_tags.size > 0 -%}
        <div class="theme-block" {{ block.shopify_attributes }}>
          <h4>
            {% render 'utility.translate', key: 'actions.explore_more', fallback: 'Explore more' %}
          </h4>

          {%- capture tag_group -%}
            {%- for tag in blog.all_tags -%}
              <li>
                {%- assign tag_link = blog.url | append: '/tagged/' | append: tag.handle -%}
                {%- render 'element.chip', label: tag, href: tag_link -%}
              </li>
            {%- endfor -%}
          {%- endcapture -%}

          {% render 'layout.stack',
            as: 'ul',
            classlist: 'tag-group no-bullets',
            slot: tag_group,
            horizontal: true,
            gap: 'sm'
          %}
        </div>
      {%- endif -%}
    {%- when 'product' -%}
      {%- unless block.settings.featured_product.empty? -%}
        <div class="theme-block" {{ block.shopify_attributes }}>
          <h4>
            {% render 'utility.translate', key: 'labels.featured_product', fallback: 'Featured product' %}
          </h4>

          {%- render 'list.product-card',
            product: block.settings.featured_product,
            sizeVariable: '40vw',
            no_actions: true,
            disabled_high_variants: false
          -%}
        </div>
      {%- endunless -%}
    {%- when 'share' -%}
      {%- if article -%}
        <div class="theme-block" {{ block.shopify_attributes }}>
          <h4>
            {% render 'utility.translate', key: 'actions.share_this', fallback: 'Share this' %}
          </h4>

          {%- render 'social.sharing',
            share_title: article.title,
            share_permalink: article.url,
            share_image: article.image
          -%}
        </div>
      {%- endif -%}
  {%- endcase -%}
{%- endfor -%}
