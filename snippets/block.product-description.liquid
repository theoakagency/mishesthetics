  Copyright © 2025 Archetype Themes LP. All rights reserved.

  Product description content with optional accordion/tab display.

  @param {object} [block] - Block object
  @param {object} [product] - Product object
  @param {boolean} [is_tab] - Render as collapsible accordion tab, default: true
  @param {boolean} [open] - Whether the description tab is open on page load, default: false
  @param {boolean} [exclusive] - Share the accordion group with the other product tabs, default: true

  @example
  {% render 'block.product-description', product: product, is_tab: true %}
  {% render 'block.product-description', product: product, is_tab: true, open: true %}
{% enddoc %}

{%- liquid
  assign product = section.settings.product | default: product
  assign is_tab = is_tab | default: block.settings.is_tab, allow_false: true | default: true, allow_false: true
  assign open = open | default: false, allow_false: true
  assign exclusive = exclusive | default: true, allow_false: true
  assign description = 'info.placeholder_product_description' | t

  if product
    assign description = product.description
  endif
-%}

{%- if is_tab -%}
  {%- liquid
    capture accordion_title
      render 'utility.translate', key: 'labels.description', fallback: 'Description'
    endcapture

    # Oak: render through the product tab snippet so the description uses the same markup and accordion group as the tabs below it
    render 'block.product-tab', block: block, title: accordion_title, tab_content: description, open: open, exclusive: exclusive
  -%}
{%- else -%}
  <div style="width: 100%;" {{ block.shopify_attributes }}>
    {%- render 'element.text', text: description, variant: 'rte' -%}
  </div>
{%- endif -%}
